{
  "name": "@boringnode/http-client",
  "description": "A small HTTP client for Node.js built on Undici",
  "version": "0.1.0",
  "main": "build/index.js",
  "type": "module",
  "files": [
    "build"
  ],
  "exports": {
    ".": "./build/index.js",
    "./testing": "./build/testing.js",
    "./types": "./build/src/types/main.js"
  },
  "scripts": {
    "build": "yarn clean && tsup-node",
    "clean": "del-cli build",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt --write .",
    "prepublishOnly": "yarn build",
    "release": "yarn dlx release-it",
    "test": "node --import=@poppinss/ts-exec --enable-source-maps bin/test.ts --reporters=dot",
    "test:coverage": "c8 yarn test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "undici": "^8.10.1"
  },
  "devDependencies": {
    "@adonisjs/tsconfig": "^2.0.0",
    "@japa/assert": "^4.2.0",
    "@japa/expect-type": "^2.0.4",
    "@japa/runner": "^5.3.0",
    "@poppinss/ts-exec": "^1.4.4",
    "@types/node": "^25.9.4",
    "c8": "^11.0.0",
    "del-cli": "^7.0.0",
    "oxfmt": "^0.56.0",
    "oxlint": "^1.71.0",
    "oxlint-tsgolint": "^7.0.2001",
    "release-it": "^20.2.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "author": "Romain Lanz <romain.lanz@pm.me>",
  "license": "MIT",
  "homepage": "https://github.com/boringnode/http-client#readme",
  "bugs": {
    "url": "https://github.com/boringnode/http-client/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/boringnode/http-client.git"
  },
  "keywords": [
    "http",
    "client",
    "undici"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "latest",
    "provenance": true
  },
  "release-it": {
    "git": {
      "commitMessage": "chore(release): ${version}",
      "tagAnnotation": "v${version}",
      "tagName": "v${version}"
    },
    "github": {
      "release": true,
      "releaseName": "v${version}"
    },
    "npm": {
      "publish": true,
      "skipChecks": true
    }
  },
  "packageManager": "yarn@4.17.0",
  "engines": {
    "node": ">=24.0.0"
  }
}
